<Window x:Class="MultilingualCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multilingual Calculator"
        Height="570"
        Width="460"
        MinHeight="570"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="Calculator"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,25"/>

        <ComboBox x:Name="LanguageComboBox"
                  Grid.Row="1"
                  Height="40"
                  FontSize="16"
                  SelectedIndex="0"
                  SelectionChanged="LanguageComboBox_SelectionChanged"
                  Margin="0,0,0,20">

            <ComboBoxItem Content="🇬🇧 English"/>
            <ComboBoxItem Content="🇰🇿 Қазақша"/>
            <ComboBoxItem Content="🇷🇺 Русский"/>

        </ComboBox>

        <TextBlock x:Name="FirstNumberText"
                   Grid.Row="2"
                   Text="First number"
                   Foreground="#D1D5DB"
                   FontSize="15"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="FirstNumberTextBox"
                 Grid.Row="3"
                 Height="45"
                 FontSize="20"
                 Padding="10,6"
                 Margin="0,0,0,15"/>

        <TextBlock x:Name="SecondNumberText"
                   Grid.Row="4"
                   Text="Second number"
                   Foreground="#D1D5DB"
                   FontSize="15"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="SecondNumberTextBox"
                 Grid.Row="5"
                 Height="45"
                 FontSize="20"
                 Padding="10,6"
                 Margin="0,0,0,20"/>

        <Grid Grid.Row="6"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="+"
                    FontSize="25"
                    Height="55"
                    Margin="3"
                    Click="OperationButton_Click"/>

            <Button Grid.Column="1"
                    Content="-"
                    FontSize="25"
                    Height="55"
                    Margin="3"
                    Click="OperationButton_Click"/>

            <Button Grid.Column="2"
                    Content="×"
                    FontSize="25"
                    Height="55"
                    Margin="3"
                    Click="OperationButton_Click"/>

            <Button Grid.Column="3"
                    Content="÷"
                    FontSize="25"
                    Height="55"
                    Margin="3"
                    Click="OperationButton_Click"/>

        </Grid>

        <StackPanel Grid.Row="7">

            <TextBlock x:Name="ResultTitleText"
                       Text="Result"
                       Foreground="#9CA3AF"
                       FontSize="16"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="ResultText"
                       Text="0"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="38"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

            <Button x:Name="ClearButton"
                    Content="Clear"
                    Height="45"
                    FontSize="16"
                    Click="ClearButton_Click"/>

        </StackPanel>

    </Grid>
</Window>